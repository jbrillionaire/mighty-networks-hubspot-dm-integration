# .env.example -- copy to .env and fill in. Never commit .env.
# Author: Jibril Sulaiman · Created: 2026-09-28

# Your Network's mn.co subdomain (the "my-community" in my-community.mn.co).
# Use the mn.co subdomain even if members reach you on a custom domain:
# the OAuth endpoints live on <subdomain>.mn.co.
MIGHTY_NETWORK=my-community

# From Network Admin > Integrations > OAuth Applications.
MIGHTY_CLIENT_ID=
# Only for a Confidential application. Leave blank for a Public one.
MIGHTY_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the application.
MIGHTY_REDIRECT_URI=http://localhost:3000/oauth/callback

# write:chats sends DMs (it includes read:chats).
# host:read:network_members lets you look recipients up by email or ID.
# read:userinfo lets whoami confirm which account the token sends as.
MIGHTY_SCOPES=read:userinfo write:chats host:read:network_members

# Sent on every API request. api.mn.co blocks requests without a User-Agent.
MIGHTY_USER_AGENT=mighty-dm-sender/0.1 (+https://example.com)

# Where tokens are stored after authorize. Gitignored.
MIGHTY_TOKEN_FILE=.tokens.json
